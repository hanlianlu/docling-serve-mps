<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <!-- Foreground mode: the package owns every parsing default (MPS device,
       ocrmac zh-Hans/en-US preset, allowed code/formula presets, decoded-image
       ceiling, scratch path). This unit only supplies what launchd does not
       inherit. `run` takes no lifecycle lock and writes no pid record, so the
       supervisor owns start, stop and restart. -->
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/.venv/bin/docling-serve-mps</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__ROOT__/.venv/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__LOGDIR__/docling-mps.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/docling-mps.err.log</string>
</dict>
</plist>
