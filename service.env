# Apple Silicon runtime
DOCLING_DEVICE=mps
PYTORCH_ENABLE_MPS_FALLBACK=1

# M4 Max: leave performance cores available for DLightRAG and macOS.
DOCLING_NUM_THREADS=8
OMP_NUM_THREADS=8
VECLIB_MAXIMUM_THREADS=8

# One converter worker avoids duplicate model memory and MPS contention.
DOCLING_SERVE_ENG_LOC_NUM_WORKERS=1
DOCLING_SERVE_LOAD_MODELS_AT_BOOT=true
DOCLING_SERVE_OPTIONS_CACHE_SIZE=2

# Keep LightRAG's auto request contract while selecting native bilingual OCR.
DOCLING_SERVE_CUSTOM_OCR_PRESETS='{"auto":{"kind":"ocrmac","framework":"vision","recognition":"accurate","lang":["zh-Hans","en-US"]}}'

# Local-only service defaults.
DOCLING_HOST=127.0.0.1
DOCLING_PORT=5001
UVICORN_WORKERS=1
DOCLING_SERVE_ENABLE_UI=true
DOCLING_SERVE_ENABLE_REMOTE_SERVICES=false
DOCLING_SERVE_ALLOW_EXTERNAL_PLUGINS=false
DOCLING_SERVE_SINGLE_USE_RESULTS=true
DOCLING_SERVE_LOG_LEVEL=INFO
DOCLING_SERVE_LOG_FORMAT=text